# My-Computer environment contract.
# Copy to .env for local dev. Never commit real values.

# --- Supabase (hot persistence) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# --- Telegram bridge (cold persistence) ---
BRIDGE_URL=
BRIDGE_TOKEN=

# --- Computer ---
DEFAULT_SESSION_NAME=my-computer
MAX_CHUNK_BYTES=8388608